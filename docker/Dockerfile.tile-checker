# Base image for tile checking operations
FROM alpine:3.18

# Install dependencies
RUN apk add --no-cache \
    g++ \
    make \
    cmake \
    libstdc++ \
    && rm -rf /var/cache/apk/*

# Set up shared volume mount point
RUN mkdir -p /mnt/assets /mnt/assets/input /mnt/assets/output /mnt/assets/logs

# Copy source code
COPY ../src /app/src
COPY ../CMakeLists.txt /app/
COPY ../config /app/config

# Build the project
WORKDIR /app
RUN mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DTARGET_SERVICE=tile-checker && \
    make tile_checker && \
    cp tile_checker /usr/local/bin/tile_checker && \
    chmod +x /usr/local/bin/tile_checker

# Set environment variables
ENV MCP_CONTAINER_MODE=true
ENV SHARED_VOLUME_PATH=/mnt/assets

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD /usr/local/bin/tile_checker --health-check || exit 1

# Set working directory
WORKDIR /app

# Default command
CMD ["/usr/local/bin/tile_checker", "--daemon"]
